    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "16.4.6",
    "@svgr/webpack": "^8.1.0",
    "cross-env": "^10.1.0",
    "dedent": "^1.7.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "globby": "^16.2.4",
    "husky": "^9.1.7",
    "inquirer": "^14.3.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.0"
  },
  "lint-staged": {
    "*.+(js|jsx|mjs|ts|tsx)": [
