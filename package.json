{
  "name": "tailwind-nextjs-starter-blog",
  "version": "1.2.1",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node ./scripts/generate-sitemap.mjs",
